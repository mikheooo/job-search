# job-search — environment template. Copy to .env and fill in.
# NEVER commit the real .env (see .gitignore).
# Maintained per audit task CFG-002; full documentation in docs/environment_variables.md.

# ===========================================================================
# 1. CRITICAL KILL-SWITCHES & SAFETY LATCHES (Default: all external actions disabled)
# ===========================================================================
# Master submission kill-switch. When false, no form submission or outbound
# application may fire anywhere across the codebase.
SUBMIT_ALLOWED=false

# Application workflow mode: REVIEW (safe preview) or AUTO (live submission)
HH_APPLY_MODE=REVIEW

# Autonomous employer chat replies kill-switches (must be explicitly enabled)
HH_AUTO_REPLY_ENABLED=false
HH_AUTONOMOUS_REPLY_ENABLED=false

# Automated submission flags (must be explicitly enabled)
HH_AUTO_SUBMIT=0
KWORK_AUTO_APPLY=false

# Emergency stop file overrides (defaults to STOP_SUBMITS / STOP_ALL_OUTBOUNDS in repo root)
#STOP_SUBMITS_FILE=/path/to/custom_stop_submits
#STOP_OUTBOUNDS_FILE=/path/to/custom_stop_outbounds
#STOP_OUTBOUNDS_DIR=/path/to/stop_files_directory

# ===========================================================================
# 2. AUTHENTICATION & SECRETS (Required for production / live operations)
# ===========================================================================
# --- Telegram digest + feedback (REQUIRED for digest delivery) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Dedicated public channel for the optional remote-vacancy channel post.
TELEGRAM_CHANNEL_ID=
# Owner numeric user id — ONLY this user may press feedback buttons.
# Without it every callback fails closed with 'Доступ запрещён'.
TELEGRAM_OWNER_ID=
# Aliases supported for backwards compatibility:
#TELEGRAM_ADMIN_ID=
#TELEGRAM_USER_ID=
#TELEGRAM_ALLOWED_USERS=
#TELEGRAM_HOME_CHANNEL=
#TG_BOT_TOKEN=
#TG_CHAT_ID=

# --- Dedicated jobs bot (REQUIRED for every Job Search notification) ---
# Every vacancy/gig/HH/control alert uses this bot. TELEGRAM_BOT_TOKEN above
# belongs to the main Hermes bot and must never be reused here.
HH_TELEGRAM_BOT_TOKEN=
HH_TELEGRAM_CHAT_ID=

# --- Dashboard auth (REQUIRED to use mutating /api endpoints) ---
# docs/dashboard-network-perimeter.md
DASHBOARD_TOKEN=

# --- LLM Provider API Key (OpenAI / Gemini / OpenRouter) ---
LLM_API_KEY=

# --- Email Outreach SMTP Secrets ---
#SMTP_USER=user@example.com
#SMTP_PASSWORD=

# --- Gig & Freelance Platform Auth ---
#FLN_OAUTH_TOKEN=

# --- Unipile Messaging Integration ---
#UNIPILE_API_KEY=
#UNIPILE_DSN=

# ===========================================================================
# 3. NETWORK PERIMETER & SERVICE ENDPOINTS
# ===========================================================================
# Dashboard host & port (defaults to secure loopback)
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8001

# Comma-separated CORS origins allowed for the dashboard.
# Empty (default) allows only http://localhost:8000 and http://127.0.0.1:8000.
DASHBOARD_CORS_ORIGINS=

# Require DASHBOARD_TOKEN on GET/HEAD to /api/* too. Default: false — only
# POST/PUT/PATCH/DELETE are protected. (Forced true if non-loopback binding).
DASHBOARD_REQUIRE_AUTH_FOR_READS=false

# Outbound service endpoints
LLM_BASE_URL=
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=465
#UNIPILE_BASE_URL=https://api1.unipile.com:13111/api/v1

# Browser CDP connection endpoints
HH_CDP_URL=http://127.0.0.1:9110
HH_HEADLESS_CDP_URL=http://127.0.0.1:9111
#CDP_URL=
#CONTRA_CDP_URL=
#HH_URL=https://hh.ru/chat

# Internal test egress blocker guard (active in test suites)
#JOB_SEARCH_TEST_NETWORK_BLOCKED=1

# ===========================================================================
# 4. RUNTIME AUTOMATION, RATE LIMITS & WATCHDOGS
# ===========================================================================
# HeadHunter browser driving mode: 'headless' (isolated Chrome) or 'browseros' (shared)
HH_BROWSER_MODE=headless
# Non-prod fallback CDP port hopping
#HH_CDP_ALLOW_FALLBACK=0
#HH_CDP_NONPROD=0

# Live browser execution flag (0: mock/CDP script; 1: live Playwright)
BROWSER_REAL=0
#BROWSER_USE_PLAYWRIGHT=0
#USE_PLAYWRIGHT=0

# Autonomous HeadHunter autopilot caps & rate limits
HH_AUTOPILOT_DAILY_CAP=12
HH_MAX_SUBMITS_PER_DAY=30
HH_MAX_SUBMITS_PER_HOUR=10
HH_AUTOPILOT_FAILURE_ALERT_COOLDOWN_SECONDS=21600

# Realtime chat daemon intervals and watchdogs
HH_REALTIME_POLL_INTERVAL=30
HH_REALTIME_HEARTBEAT_INTERVAL=60
HH_REALTIME_PAUSE_ALERT_SECONDS=1800
HH_REALTIME_PAUSE_ALERT_COOLDOWN_SECONDS=3600
HH_REALTIME_HEARTBEAT_STALE_SECONDS=600
HH_REALTIME_AUTH_RETRY_SECONDS=300
HH_REALTIME_BROWSER_RECOVERY_BASE_SECONDS=5
HH_REALTIME_BROWSER_RECOVERY_MAX_SECONDS=300

# Gig platform automation toggles and watchdogs
KWORK_MONITOR_ENABLED=true
KWORK_INBOX_ALERT_COOLDOWN_SECONDS=14400
KWORK_INBOX_NOT_READY_STREAK=3
#GIG_ENABLE_CONTRA=false
#GIG_ENABLE_FREELANCER=false

# Production circuit breaker & alerts
PRODUCTION_FAILURE_ALERT_THRESHOLD=3
DIGEST_ATTEMPT_STALE_MINUTES=60

# Telegram anti-spam / feedback flags
TELEGRAM_NOTIFY_POLICY_ENABLED=false
TELEGRAM_FLASH_SUPPRESS_ENABLED=false
TELEGRAM_FB_CALLBACKS_ENABLED=false

# ===========================================================================
# 5. STORAGE & FILE SYSTEM PATHS (Defaults resolve relative to repo)
# ===========================================================================
#PROJECT_ROOT=
#JOB_SEARCH_ROOT=
#DB_FILE=state.db
#VACANCIES_FILE=vacancies.json
#LOGS_DIR=logs/job_search
#CANDIDATE_PROFILE_FILE=candidate_profile.json
#CANDIDATE_PROFILE=candidate_profile.json
#CANDIDATE_KB_FILE=candidate_kb.json
#CANDIDATE_PROJECTS_ROOT=candidate_projects
#CANDIDATE_INTERVIEW_STATE=candidate_interview_state.json
#HERMES_ROOT=
#HERMES_HOME=
#HERMES_ENV_FILE=
#HH_HEADLESS_PROFILE=%LOCALAPPDATA%\JobSearchHeadless\User Data
#HH_CHROME_PROFILE=
#CHROME_PATH=
HH_STORAGE_STATE=hh_storage_state.json
#GIG_FIXTURE_FILE=
#STT_MODEL_DIR=
#VOSK_MODEL_DIR=

# ===========================================================================
# 6. OPERATOR MATCHING & SCORING TUNING
# ===========================================================================
LLM_MODEL=google/gemini-1.5-pro
STOP_WORDS=
REQUIRED_WORDS=
MIN_SALARY=0
BATCH_LIMIT=10

# Candidate preference calibration
PREFERENCE_CALIBRATION_ENABLED=false
PREFERENCE_MAX_ADJUSTMENT=8.0
PREFERENCE_MIN_EVIDENCE_THRESHOLD=5

# Speech-to-text & interview tuning
STT_DEVICE=auto
CANDIDATE_INTERVIEW_LLM=offline

# Operational dry-run defaults
HH_DRY_RUN=true
EMAIL_DRY_RUN=true

# ===========================================================================
# 7. DIAGNOSTICS, ENVIRONMENT & OFFLINE MOCKS
# ===========================================================================
JOB_SEARCH_ENV=prod
#APP_ENV=prod
#ENV=prod
#APPLICATION_PREP_OFFLINE=0
#EXTERNAL_FORM_FILLER_OFFLINE=0
#JOB_ANALYZER_OFFLINE=0
#LEGACY_BOT_OVERRIDE=0
#LEGACY_PIPELINE_OVERRIDE=0
#GOOGLE_APPLICATION_CREDENTIALS=
#GOOGLE_CLOUD_PROJECT=
#VERTEX_CREDENTIALS_PATH=
#VERTEX_PROJECT=
#VERTEX_PROJECT_ID=
#TEST_ENVIRONMENT_MOCK=0
