# job-search — environment template. Copy to .env and fill in.
# NEVER commit the real .env (see .gitignore).

# --- Paths (optional; defaults resolve relative to this repo) ---
#JOB_SEARCH_ROOT=
#PROJECT_ROOT=
#VACANCIES_FILE=
#DB_FILE=
#CANDIDATE_PROFILE_FILE=
#LOGS_DIR=
#HERMES_ROOT=
#HH_CHROME_PROFILE=

# --- LLM (OpenAI-compatible) ---
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=google/gemini-1.5-pro

# --- Telegram digest + feedback (REQUIRED for digest delivery) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Dedicated public channel for the optional remote-vacancy channel post.
TELEGRAM_CHANNEL_ID=
# Owner numeric user id — ONLY this user may press feedback buttons.
# Without it every callback fails closed with "Доступ запрещён".
TELEGRAM_OWNER_ID=

# --- Dedicated jobs bot (REQUIRED for every Job Search notification) ---
# Every vacancy/gig/HH/control alert uses this bot. TELEGRAM_BOT_TOKEN above
# belongs to the main Hermes bot and must never be reused here.
# Phase 3: all HH/control code reads these keys — no hardcoded tokens.
HH_TELEGRAM_BOT_TOKEN=
HH_TELEGRAM_CHAT_ID=

# --- Dashboard auth (REQUIRED to use mutating /api endpoints) ---
# Полное описание периметра, авторизации и того, чего здесь нет:
# docs/dashboard-network-perimeter.md
# Mutations without it return 503; wrong token returns 401.
DASHBOARD_TOKEN=

# Comma-separated CORS origins allowed for the dashboard.
# Empty (default) allows only http://localhost:8000 and http://127.0.0.1:8000.
DASHBOARD_CORS_ORIGINS=

# Require DASHBOARD_TOKEN on GET/HEAD to /api/* too. Default: false — only
# POST/PUT/PATCH/DELETE are protected. Accepts 1/true/yes.
# The dashboard page itself ("/") always stays open: otherwise there is nowhere
# to type the token. The UI keeps the token in localStorage and sends it as
# Authorization: Bearer on every /api/ call.
DASHBOARD_REQUIRE_AUTH_FOR_READS=false

# --- Safety kill-switches (default: everything external is REVIEW-only) ---
SUBMIT_ALLOWED=false
HH_APPLY_MODE=REVIEW
HH_AUTO_REPLY_ENABLED=false

# --- Autonomous HH autopilot (owner standing authorization, 2026-10-19) ---
# SUBMIT_ALLOWED above is the authoritative switch: the autopilot refuses to
# click when it is off and never re-arms it itself.
# Max autonomous applications per day (the 4-hourly cycle also has its own
# per-cycle limit of 8).
HH_AUTOPILOT_DAILY_CAP=12

# --- Realtime chat daemon observability / pause watchdog (2026-10-19) ---
# While the autopilot holds its browser lock the daemon pauses. It now writes a
# heartbeat file and logs PAUSED/RESUMED transitions; a pause or a lack of
# successful chat checks longer than the alert threshold pages the owner once,
# with the cooldown preventing a repeat for the same incident.
HH_REALTIME_HEARTBEAT_INTERVAL=60
HH_REALTIME_PAUSE_ALERT_SECONDS=1800
HH_REALTIME_PAUSE_ALERT_COOLDOWN_SECONDS=3600
HH_REALTIME_HEARTBEAT_STALE_SECONDS=600

# --- Telegram anti-spam / feedback flags (PROJECT_STATE §12) ---
TELEGRAM_NOTIFY_POLICY_ENABLED=false
TELEGRAM_FLASH_SUPPRESS_ENABLED=false
TELEGRAM_FB_CALLBACKS_ENABLED=false

# --- HeadHunter browser session ---
HH_STORAGE_STATE=hh_storage_state.json
# T7.21: which browser the HH workflows drive. Explicit, never probed.
#   headless  = our own Chrome (--headless=new), profile
#               %LOCALAPPDATA%\JobSearchHeadless\User Data, CDP 9111.
#               No window on the desktop; the runner starts and stops it itself.
#   browseros = the historical path: HH_CDP_URL (9110) / 9222, needs BrowserOS running.
HH_BROWSER_MODE=headless
# BrowserOS address. Not used in headless mode - it names a different profile.
HH_CDP_URL=http://127.0.0.1:9110
# Optional overrides for the headless instance (defaults shown):
# HH_HEADLESS_CDP_URL=http://127.0.0.1:9111
# HH_HEADLESS_PROFILE=%LOCALAPPDATA%\JobSearchHeadless\User Data


# --- Matching / prefilter tuning ---
STOP_WORDS=
REQUIRED_WORDS=
MIN_SALARY=0
BATCH_LIMIT=10

# --- Production circuit breaker ---
PRODUCTION_FAILURE_ALERT_THRESHOLD=3
DIGEST_ATTEMPT_STALE_MINUTES=60

# --- Preference calibration (feature-flagged, default off) ---
PREFERENCE_CALIBRATION_ENABLED=false
PREFERENCE_MAX_ADJUSTMENT=8.0
PREFERENCE_MIN_EVIDENCE_THRESHOLD=5
