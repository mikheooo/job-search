# job-search — environment template. Copy to .env and fill in.
# NEVER commit the real .env (see .gitignore).

# --- Paths (optional; defaults resolve to project root) ---
#VACANCIES_FILE=C:\Users\Misha\Documents\job-search\vacancies.json
#DB_FILE=C:\Users\Misha\Documents\job-search\state.db
#CANDIDATE_PROFILE_FILE=C:\Users\Misha\Documents\job-search\candidate_profile.json
#LOGS_DIR=C:\Users\Misha\Documents\job-search\logs\job_search

# --- LLM (OpenAI-compatible) ---
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=google/gemini-1.5-pro

# --- Telegram digest + feedback (REQUIRED for digest delivery) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Owner numeric user id — ONLY this user may press feedback buttons.
# Without it every callback fails closed with "Доступ запрещён".
TELEGRAM_OWNER_ID=

# --- Dashboard auth (REQUIRED to use mutating /api endpoints) ---
# Mutations without it return 503; wrong token returns 401.
DASHBOARD_TOKEN=

# Comma-separated CORS origins allowed for the dashboard.
# Empty (default) allows only http://localhost:8000 and http://127.0.0.1:8000.
DASHBOARD_CORS_ORIGINS=

# Require DASHBOARD_TOKEN on GET/HEAD to /api/* too. Default: false — only
# POST/PUT/PATCH/DELETE are protected. Accepts 1/true/yes.
# The dashboard page itself ("/") always stays open: otherwise there is nowhere
# to type the token. The UI keeps the token in localStorage and sends it as
# Authorization: Bearer on every /api/ call.
DASHBOARD_REQUIRE_AUTH_FOR_READS=false

# --- Safety kill-switches (default: everything external is REVIEW-only) ---
SUBMIT_ALLOWED=false
HH_APPLY_MODE=REVIEW
HH_AUTO_REPLY_ENABLED=false

# --- HeadHunter browser session ---
HH_STORAGE_STATE=hh_storage_state.json
HH_CDP_URL=http://127.0.0.1:9222

# --- Matching / prefilter tuning ---
STOP_WORDS=
REQUIRED_WORDS=
MIN_SALARY=0
BATCH_LIMIT=10

# --- Production circuit breaker ---
PRODUCTION_FAILURE_ALERT_THRESHOLD=3
DIGEST_ATTEMPT_STALE_MINUTES=60

# --- Preference calibration (feature-flagged, default off) ---
PREFERENCE_CALIBRATION_ENABLED=false
PREFERENCE_MAX_ADJUSTMENT=8.0
PREFERENCE_MIN_EVIDENCE_THRESHOLD=5
